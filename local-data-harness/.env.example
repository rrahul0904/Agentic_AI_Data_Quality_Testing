# Local Data Harness
LDH_PROVIDER=mock
LDH_MODEL=qwen3:8b
LDH_MODE=analyst
LDH_OLLAMA_URL=http://127.0.0.1:11434

# Optional executable overrides after scripts/bootstrap-data-stack.sh
# LDH_PYTHON_BIN=/absolute/path/to/local-data-harness/.venv-data/bin/python
# LDH_DBT_BIN=/absolute/path/to/local-data-harness/.venv-data/bin/dbt
# LDH_AIRFLOW_BIN=/absolute/path/to/local-data-harness/.venv-airflow/bin/airflow

# Snowflake: either use a named ~/.snowflake/connections.toml connection ...
# SNOWFLAKE_CONNECTION_NAME=myconnection

# ... or environment-based auth. Do not commit real credentials.
# SNOWFLAKE_ACCOUNT=myorg-myaccount
# SNOWFLAKE_USER=myuser
# SNOWFLAKE_PASSWORD=secret
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=ANALYTICS
# SNOWFLAKE_SCHEMA=DEV
# SNOWFLAKE_ROLE=TRANSFORMER
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
