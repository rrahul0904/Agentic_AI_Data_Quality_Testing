{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "framework": "nextjs",
      "root": "apps/web/",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "ADE_API_URL"
        }
      ]
    },
    "api": {
      "framework": "container",
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
