# Copy to backend/.env and adjust. Values shown are what the local demo uses.
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin123
AIRFLOW_DAG_ID=data_quality_pipeline

# Uncomment to point at a different dbt project (e.g. a real Snowflake/BigQuery/
# Databricks-backed one) instead of the bundled DuckDB demo:
# DBT_PROJECT_DIR=/path/to/your/dbt/project
# DBT_PROFILES_DIR=/path/to/your/dbt/profiles
# DBT_TARGET=prod

# LLM Gateway (services/llm_gateway.py) -- only used to escalate RCA when the
# deterministic lineage walk finds more than one upstream dataset failing at
# once (see services/rca.py). Leave unset and everything else still works;
# ambiguous RCA cases just come back UNVERIFIED instead of LLM-resolved.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
