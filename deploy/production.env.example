# Agentic Data Engineering OS production environment template
# Copy to an operator-controlled secret/config store. Never commit real values.

# Exact release identity. Use the Git SHA associated with the deployed immutable images.
ADE_COMMIT_SHA=

# API authentication. Generate long random values and keep the web service token aligned
# with a configured API credential that has only the role required by the web application.
ADE_API_KEYS_JSON={"web":{"token":"replace-with-at-least-24-random-characters","subject":"ade-web","role":"analyst"},"admin":{"token":"replace-with-a-different-long-random-token","subject":"ade-admin","role":"admin"}}
ADE_API_SERVICE_TOKEN=replace-with-the-web-token-above

# Web authentication. Replace the example credentials before startup.
ADE_WEB_USERS_JSON={"operator":"replace-with-a-long-random-password"}
ADE_WEB_BIND=127.0.0.1
ADE_WEB_PORT=3000

# Project source. embedded_demo is safe for evaluation. For managed customer projects,
# use git plus an allowlisted HTTPS host and immutable commit/tag where possible.
ADE_PROJECT_SOURCE_MODE=embedded_demo
ADE_PROJECT_ROOT=/app/hospitality-snowflake-data-platform
ADE_PROJECT_GIT_URL=
ADE_PROJECT_GIT_REF=
ADE_PROJECT_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# Durable control-plane backends. Empty values keep the single-node SQLite fallback on
# the persistent /state volume. Production SaaS should normally use managed PostgreSQL.
ADE_DATABASE_URL=
ADE_INVESTIGATION_DATABASE_URL=
ADE_QUALITY_DATABASE_URL=

# Artifact storage. Filesystem uses the persistent /state volume. For multi-node hosting,
# configure an S3-compatible bucket and the runtime's normal cloud credentials.
ADE_ARTIFACT_STORE_MODE=filesystem
ADE_ARTIFACT_BUCKET=
ADE_ARTIFACT_PREFIX=ade
ADE_ARTIFACT_ENDPOINT_URL=
ADE_ARTIFACT_REGION=

# Commercial packaging. optional keeps self-hosted/community installs usable without a
# paid entitlement. Set required only for a hosted SaaS environment after Stripe webhook
# delivery and entitlement persistence have been verified end to end.
ADE_BILLING_ENFORCEMENT=optional
ADE_PROFESSIONAL_PRICE_LABEL=USD 99/month
ADE_ENTERPRISE_CONTACT_URL=

# Stripe server-side configuration. Keep these values in the API secret manager only.
# Checkout remains fail-closed until the secret key, recurring Price ID, webhook secret,
# and an allowed HTTPS return origin are all configured.
ADE_STRIPE_SECRET_KEY=
ADE_STRIPE_WEBHOOK_SECRET=
ADE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=
ADE_BILLING_ALLOWED_RETURN_ORIGINS=

# Optional external assurance receipt/certification reference.
ADE_EXTERNAL_ASSURANCE_EVIDENCE=
