# Copy only if you want to manage credentials manually.
# Preferred: bash scripts/ade-local.sh init

ADE_API_BIND=127.0.0.1
ADE_API_PORT=8001
ADE_WEB_BIND=127.0.0.1
ADE_WEB_PORT=3000
ADE_COMMIT_SHA=local

# API tokens must be at least 24 characters. Keep the same token in all three places below.
ADE_API_SERVICE_TOKEN=replace-with-a-long-random-token
ADE_API_KEYS_JSON='{"local-admin":{"token":"replace-with-a-long-random-token","subject":"local-admin","role":"admin"}}'

# Optional Basic credentials for explicit proxy smoke tests or a local reverse proxy.
ADE_WEB_USER=admin
ADE_WEB_PASSWORD=replace-with-a-long-random-password
ADE_WEB_USERS_JSON='{"admin":{"password":"replace-with-a-long-random-password","api_token":"replace-with-a-long-random-token"}}'
