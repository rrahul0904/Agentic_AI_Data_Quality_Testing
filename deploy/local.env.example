# Copy only if you want to manage credentials manually.
# Preferred: bash scripts/ade-local.sh init

ADE_API_BIND=127.0.0.1
ADE_API_PORT=8001
ADE_WEB_BIND=127.0.0.1
ADE_WEB_PORT=3000
ADE_COMMIT_SHA=local

# API tokens must be at least 24 characters. Keep the same token in both places below.
ADE_API_SERVICE_TOKEN=replace-with-a-long-random-token
ADE_API_KEYS_JSON='{"local-admin":{"token":"replace-with-a-long-random-token","subject":"local-admin","role":"admin"}}'
