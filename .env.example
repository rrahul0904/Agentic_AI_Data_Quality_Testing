ADE_AGENT_CONTEXT_TOKENS=32000
ADE_AGENT_CONTEXT_CHUNKS=6
ADE_AGENT_MAX_OUTPUT_TOKENS=1600
ADE_OPENAI_REASONING_EFFORT=low
